<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.codex.androidtviptvplayer">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".PlaylistApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidTVIptvPlayer">

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.codex.androidtviptvplayer.workmanager.WorkManagerInitializer"
                android:value="androidx.startup" />
        </provider>

        <activity
            android:name=".ui.search.SearchActivity"
            android:exported="false"
            android:label="@string/title_search" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings" />

        <activity
            android:name=".ui.playlist.PlaylistImportActivity"
            android:exported="false"
            android:label="@string/title_import_playlist" />

        <activity
            android:name=".ui.player.PlayerActivity"
            android:exported="false"
            android:label="@string/title_player"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout"
            android:launchMode="singleTop" />

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="androidx.work.impl.background.systemjob.SystemJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
