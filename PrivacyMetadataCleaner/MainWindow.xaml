<Window x:Class="PrivacyMetadataCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Privacy Metadata Cleaner"
        Width="1100"
        Height="720"
        MinWidth="960"
        MinHeight="600"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF1E3C72" Offset="0" />
            <GradientStop Color="#FF203A5C" Offset="0.5" />
            <GradientStop Color="#FF172134" Offset="1" />
        </LinearGradientBrush>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="8 0" />
            <Setter Property="Padding" Value="16 8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF3A6FD8" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#99000000" BlurRadius="12" ShadowDepth="2" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowBackground}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="24" CornerRadius="16" Background="#22FFFFFF">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Vertical" Spacing="8">
                        <TextBlock Text="隐私元数据清理工具" FontSize="28" Foreground="White" FontWeight="SemiBold" />
                        <TextBlock Text="批量移除文档、PDF 和图片中的敏感属性，确保安全分享。"
                                   Foreground="#CCFFFFFF"
                                   FontSize="14" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="添加文件" Command="{Binding AddFilesCommand}" />
                        <Button Content="清理元数据" Command="{Binding CleanMetadataCommand}" Background="#FF26A65B" />
                        <Button Content="导出日志" Command="{Binding ExportLogCommand}" Background="#FF4C4CFF" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,24,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border CornerRadius="16" Background="#F9FFFFFF" Padding="16" Margin="0,0,16,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="待处理文件" FontSize="18" FontWeight="SemiBold" Foreground="#FF1A2233" />
                            <TextBlock Text="{Binding Files.Count, StringFormat=（共 {0} 个）}"
                                       Foreground="#881A2233"
                                       Margin="12,0,0,0" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Files}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  RowBackground="#11E0E6F1"
                                  AlternatingRowBackground="#22E0E6F1"
                                  GridLinesVisibility="None"
                                  SelectionMode="Extended"
                                  BorderThickness="0"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="*" />
                                <DataGridTextColumn Header="类型" Binding="{Binding FileType}" Width="120" />
                                <DataGridTextColumn Header="大小" Binding="{Binding FileSize}" Width="120" />
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="120" />
                                <DataGridTextColumn Header="路径" Binding="{Binding FilePath}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" CornerRadius="16" Background="#F2FFFFFF" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="操作日志" FontSize="18" FontWeight="SemiBold" Foreground="#FF1A2233" />
                            <TextBlock Text="实时显示清理进度与详情" Foreground="#881A2233" Margin="12,2,0,0" />
                        </StackPanel>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding LogEntries}"
                                 Background="#11FFFFFF"
                                 BorderThickness="0"
                                 Foreground="#FF1A2233"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Vertical" Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#CCFFFFFF" FontSize="14" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ProgressValue, StringFormat={}{0:F0}%}"
                               Foreground="#CCFFFFFF"
                               FontSize="14"
                               HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar Value="{Binding ProgressValue}"
                             Minimum="0"
                             Maximum="100"
                             Height="8"
                             Background="#338EA1BF"
                             Foreground="#FF4C83FF" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                    <TextBlock Text="支持 .docx、.pdf、.jpg/.jpeg/.png 文件类型" Foreground="#CCFFFFFF" />
                    <Separator Width="1" Height="14" Background="#44FFFFFF" />
                    <TextBlock Text="请在清理前备份重要文件" Foreground="#CCFFFFFF" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
